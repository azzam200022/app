# JSON for a Firebase service account. Store the real value as a deployment secret.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id"}

# Initial default is 2000 Iraqi dinars. The manager can change it in the
# delivery-pricing screen; the value is stored in Firestore.

# Optional: set this on the backend host to show actual road distance from the store.
# Store the real API key in the host's secret manager; never commit it.
# OPENROUTESERVICE_API_KEY=
# Actual shop coordinates are required for trustworthy road-distance lookups; set both values.
# STORE_LAT=
# STORE_LNG=
